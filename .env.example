# DriveDoc frontend configuration.
# Copy to .env. Everything here ships to the browser, so never put a secret in
# this file — only public, client-side values belong in VITE_* variables.

# OAuth client ID from Google Cloud Console. Must match GOOGLE_CLIENT_ID on the
# backend, which verifies that sign-in tokens were issued for this client.
VITE_GOOGLE_CLIENT_ID=

# Where the API lives.
#   /api                                  → use the Netlify proxy in public/_redirects
#                                           (keeps the auth cookie first-party — preferred)
#   http://localhost:5000/api             → talk to a local backend directly
VITE_API_URL=/api
